{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Rafflesia",
  "description": "Protein homology search over immutable database releases.",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://rafflesia.ai"
  },
  "favicon": {
    "light": "/favicon/light.png",
    "dark": "/favicon/dark.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "homology-search/index",
              "ontology/index"
            ]
          },
          {
            "group": "Clients",
            "pages": [
              "cli/overview",
              "sdks/index"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "api-reference/introduction",
              "errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "/api-reference/openapi.json",
              "directory": "api-reference/endpoints"
            },
            "pages": [
              {
                "group": "Homology",
                "pages": [
                  "POST /v1/homology",
                  "POST /v1/homology/batch",
                  "GET /v1/homology/databases",
                  "GET /v1/homology/databases/{database_id}/releases"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://dashboard.rafflesia.ai",
          "icon": "layout-dashboard"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/rafflesia-ai",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://dashboard.rafflesia.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://rafflesia.ai",
      "github": "https://github.com/rafflesia-ai"
    }
  },
  "redirects": [
    {
      "source": "/api-reference",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/cli",
      "destination": "/cli/overview"
    }
  ],
  "seo": {
    "metatags": {
      "og:site_name": "Rafflesia docs"
    },
    "indexing": "navigable"
  },
  "contextual": {
    "options": [
      "copy"
    ]
  }
}
