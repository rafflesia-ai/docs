{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Rafflesia",
  "description": "Protein homology search over immutable database releases.",
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/rafflesia-logo-black.svg",
    "dark": "/logo/rafflesia-logo-white.svg",
    "href": "https://rafflesia.ai"
  },
  "favicon": {
    "light": "/favicon/light.png",
    "dark": "/favicon/dark.png"
  },
  "api": {
    "examples": {
      "autogenerate": false
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "homology-search/index",
              "ontology/index"
            ]
          },
          {
            "group": "Clients",
            "pages": [
              "cli/overview",
              "sdks/index",
              "sdks/sql"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "api-reference/introduction",
              "errors"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "https://raw.githubusercontent.com/rafflesia-ai/docs/main/api-reference/openapi.json",
              "directory": "api-reference/endpoints"
            },
            "pages": [
              {
                "group": "Homology",
                "pages": [
                  "POST /v1/homology",
                  "POST /v1/homology/batch",
                  "POST /v1/homology/searches",
                  "GET /v1/homology/searches",
                  "GET /v1/homology/searches/{homology_search_id}",
                  "POST /v1/homology/searches/{homology_search_id}/cancel",
                  "GET /v1/homology/searches/{homology_search_id}/results",
                  "GET /v1/homology/databases",
                  "GET /v1/homology/databases/{database_id}/releases"
                ]
              },
              {
                "group": "SQL credentials",
                "pages": [
                  "GET /v1/sql-credentials",
                  "POST /v1/sql-credentials",
                  "POST /v1/sql-credentials/{credential_id}/rotate",
                  "GET /v1/sql-credentials/{credential_id}/usage",
                  "DELETE /v1/sql-credentials/{credential_id}"
                ]
              },
              {
                "group": "Account",
                "pages": [
                  "GET /v1/account/billing"
                ]
              },
              {
                "group": "Models",
                "pages": [
                  "GET /v1/models",
                  "GET /v1/models/pricing",
                  "POST /v1/models/pricing/estimate",
                  "GET /v1/models/usage",
                  "GET /v1/models/billing-events",
                  "GET /v1/models/analytics",
                  "GET /v1/models/requests/by-endpoint",
                  "DELETE /v1/models/requests/{request_id}/payloads"
                ]
              },
              {
                "group": "Runs",
                "pages": [
                  "POST /v1/runs",
                  "GET /v1/runs",
                  "GET /v1/runs/{run_id}",
                  "GET /v1/runs/{run_id}/status",
                  "GET /v1/runs/{run_id}/status/stream",
                  "GET /v1/runs/{run_id}/result",
                  "POST /v1/runs/{run_id}/cancel"
                ]
              },
              {
                "group": "Events",
                "pages": [
                  "GET /v1/events",
                  "GET /v1/events/stream",
                  "GET /v1/events/{event_id}"
                ]
              },
              {
                "group": "Webhook endpoints",
                "pages": [
                  "GET /v1/webhooks/endpoints",
                  "POST /v1/webhooks/endpoints",
                  "GET /v1/webhooks/endpoints/{endpoint_id}",
                  "PATCH /v1/webhooks/endpoints/{endpoint_id}",
                  "DELETE /v1/webhooks/endpoints/{endpoint_id}",
                  "POST /v1/webhooks/endpoints/{endpoint_id}/secret-rotations"
                ]
              },
              {
                "group": "Webhook deliveries",
                "pages": [
                  "GET /v1/webhooks/deliveries",
                  "POST /v1/webhooks/deliveries",
                  "GET /v1/webhooks/deliveries/{delivery_id}"
                ]
              },
              {
                "group": "Limits",
                "pages": [
                  "GET /v1/limits"
                ]
              },
              {
                "group": "Files",
                "pages": [
                  "POST /v1/files",
                  "GET /v1/files/{file_id}",
                  "HEAD /v1/files/{file_id}",
                  "GET /v1/storage/files",
                  "DELETE /v1/storage/files",
                  "POST /v1/storage/files/import",
                  "POST /v1/storage/files/move"
                ]
              },
              {
                "group": "File access",
                "pages": [
                  "GET /v1/storage/files/acl",
                  "PUT /v1/storage/files/acl",
                  "POST /v1/storage/file-signed-urls",
                  "GET /v1/storage/settings",
                  "PUT /v1/storage/settings"
                ]
              },
              {
                "group": "Resumable uploads",
                "pages": [
                  "POST /v1/storage/uploads",
                  "GET /v1/storage/uploads/{upload_id}",
                  "DELETE /v1/storage/uploads/{upload_id}",
                  "POST /v1/storage/uploads/{upload_id}/parts",
                  "PUT /v1/storage/uploads/{upload_id}/parts/{part_number}",
                  "POST /v1/storage/uploads/{upload_id}/parts/{part_number}",
                  "POST /v1/storage/uploads/{upload_id}/complete"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://dashboard.rafflesia.ai",
          "icon": "layout-dashboard"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/rafflesia-ai",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://dashboard.rafflesia.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://rafflesia.ai",
      "github": "https://github.com/rafflesia-ai"
    }
  },
  "redirects": [
    {
      "source": "/api-reference",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/cli",
      "destination": "/cli/overview"
    }
  ],
  "seo": {
    "metatags": {
      "og:site_name": "Rafflesia docs"
    },
    "indexing": "navigable"
  },
  "contextual": {
    "options": [
      "copy"
    ]
  }
}
